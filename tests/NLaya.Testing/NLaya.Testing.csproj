<Project Sdk="Microsoft.NET.Sdk">
  <!-- Helpers and golden fixtures shared by NLaya.Tests and NLaya.Parity. Not a test project itself. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.assert" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NLaya/NLaya.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by tools/fixtures/make_fixtures.py; copied into each referencing test project's output. -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
