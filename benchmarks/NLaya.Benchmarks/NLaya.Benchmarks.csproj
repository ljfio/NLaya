<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The libtorch runtime; on a CUDA machine pass -p:TorchSharpRuntime=TorchSharp-cuda-linux (or -windows). -->
    <TorchSharpRuntime Condition="'$(TorchSharpRuntime)' == ''">TorchSharp-cpu</TorchSharpRuntime>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NLaya/NLaya.csproj" />
    <ProjectReference Include="../../src/NLaya.TorchSharp/NLaya.TorchSharp.csproj" />
    <PackageReference Include="$(TorchSharpRuntime)" Version="0.107.0" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
  </ItemGroup>
</Project>
