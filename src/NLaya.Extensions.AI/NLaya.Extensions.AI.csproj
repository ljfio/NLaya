<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source-generated configuration binding: reflection-free, so LayaSettings binds under Native AOT. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <Description>Microsoft.Extensions.AI middleware (guardrail, router, tools) and dependency injection for NLaya.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NLaya/NLaya.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>
</Project>
