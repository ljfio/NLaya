<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Typed, calibrated System 1 decisions with the Laya models (.NET port of the laya Python library).</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NLaya.Tests" />
    <InternalsVisibleTo Include="NLaya.Parity" />
    <InternalsVisibleTo Include="NLaya.TorchSharp" />
    <InternalsVisibleTo Include="NLaya.Onnx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Lang/lang_data.json" LogicalName="NLaya.Lang.lang_data.json" />
    <EmbeddedResource Include="Email/email_data.json" LogicalName="NLaya.Email.email_data.json" />
    <EmbeddedResource Include="Presets/presets.json" LogicalName="NLaya.Presets.presets.json" />
  </ItemGroup>
</Project>
